{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jinlio/deep-research-skill/blob/main/protocol/capability.schema.json",
  "title": "Deep Research Runtime Capability",
  "type": "object",
  "required": ["runtime", "capabilities"],
  "properties": {
    "runtime": {"type": "string", "minLength": 1},
    "version": {"type": "string"},
    "observed_at": {"type": "string"},
    "capabilities": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {"type": "boolean"},
          {
            "type": "object",
            "required": ["available"],
            "properties": {
              "available": {"type": "boolean"},
              "tested": {"type": "boolean"},
              "mode": {"type": "string"},
              "evidence": {"type": "array", "items": {"type": "string"}}
            },
            "additionalProperties": true
          }
        ]
      }
    },
    "permissions": {
      "type": "object",
      "properties": {"external_write_default": {"type": "boolean"}},
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
